{
    "version": 2,
    "builds": [
        {
            "src": "index.html",
            "use": "@vercel/static"
        },
        {
            "src": "api/*.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/api/ingest",
            "dest": "/api/ingest.py"
        },
        {
            "src": "/api/ask",
            "dest": "/api/ask.py"
        },
        {
            "src": "/",
            "dest": "/index.html"
        }
    ]
}
