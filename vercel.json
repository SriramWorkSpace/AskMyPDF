{
    "version": 2,
    "builds": [
        {
            "src": "api/*.py",
            "use": "@vercel/python@3.1.0"
        }
    ],
    "routes": [
        {
            "src": "/api/ingest",
            "dest": "/api/ingest.py"
        },
        {
            "src": "/api/ask",
            "dest": "/api/ask.py"
        }
    ]
}